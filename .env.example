DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Auth.js шифрует JWT сессии этим ключом. Сгенерировать: pnpm dlx auth secret
AUTH_SECRET=

# GitHub OAuth App → Client ID / Client Secret (next-auth v5 подхватывает сам)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Абсолютный origin для metadataBase / OG. На Vercel — production URL (шаг 1.7).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Vercel AI Gateway (AI SDK, только сервер). Без ключа Suggest subtasks ответит ошибкой, UI не падает.
# Ключ: https://vercel.com/docs/ai-gateway — не NEXT_PUBLIC_.
AI_GATEWAY_API_KEY=

# GlitchTip (Sentry-совместимый DSN). Пусто = SDK молчит. Не sentry.io, не token карт.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=

# Upload source maps на билде (Vercel Production / Build). Пусто = skip, `pnpm build` не падает.
# Token не NEXT_PUBLIC_. Org/project slug — не секреты, но в git значения не коммитим.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_URL="https://app.glitchtip.com"

DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Auth.js шифрует JWT сессии этим ключом. Сгенерировать: pnpm dlx auth secret
AUTH_SECRET=

# GitHub OAuth App → Client ID / Client Secret (next-auth v5 подхватывает сам)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Абсолютный origin для metadataBase / OG. На Vercel — production URL (шаг 1.7).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Vercel AI Gateway (AI SDK, только сервер). Без ключа Suggest subtasks ответит ошибкой, UI не падает.
# Ключ: https://vercel.com/docs/ai-gateway — не NEXT_PUBLIC_.
AI_GATEWAY_API_KEY=

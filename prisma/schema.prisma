generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ActivityType {
  BOARD_CREATED
  BOARD_DELETED
  COLUMN_CREATED
  COLUMN_DELETED
  CARD_CREATED
  CARD_UPDATED
  CARD_MOVED
  CARD_DELETED
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  boards     Board[]
  activities ActivityLog[]
}

model Board {
  id        String   @id @default(cuid())
  title     String
  ownerId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner      User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  columns    Column[]
  activities ActivityLog[]

  @@index([ownerId])
}

model Column {
  id        String   @id @default(cuid())
  title     String
  position  Int
  boardId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  board Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  cards Card[]

  @@index([boardId, position])
}

model Card {
  id          String   @id @default(cuid())
  title       String
  description String?
  position    Int
  columnId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  column     Column        @relation(fields: [columnId], references: [id], onDelete: Cascade)
  activities ActivityLog[]

  @@index([columnId, position])
}

model ActivityLog {
  id        String       @id @default(cuid())
  type      ActivityType
  payload   Json?
  userId    String
  boardId   String
  cardId    String?
  createdAt DateTime     @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  board Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  card  Card?  @relation(fields: [cardId], references: [id], onDelete: SetNull)

  @@index([boardId])
  @@index([userId])
  @@index([cardId])
}
